{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "files": {
        "includes": ["**", "!**/www/assets/threejs", "!**/www/resources"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    }
}
